# clipper — who runs it and how changes travel. Source of docs/architecture/collaboration.svg
# Edit when agents, sharing or the review flow change, then: bash docs/architecture/render.sh

vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
    pad: 40
  }
}
direction: down

classes: {
  person: {shape: person; style: {fill: "#EAF2FF"; stroke: "#3B6FD8"; stroke-width: 2; font-color: "#1B2F5E"}}
  agent: {shape: hexagon; style: {fill: "#FFF1D6"; stroke: "#D98A00"; stroke-width: 2; font-color: "#5A3A00"}}
  rule: {shape: document; style: {fill: "#F2F2F4"; stroke: "#8A8A99"; stroke-width: 2; font-color: "#333344"}}
  repo: {style: {fill: "#E6F7EC"; stroke: "#1E9E55"; stroke-width: 2; border-radius: 10; font-color: "#0E4A28"}}
  check: {shape: diamond; style: {fill: "#EAF2FF"; stroke: "#3B6FD8"; stroke-width: 2; font-color: "#1B2F5E"}}
  stage: {style: {fill: "#FFFFFF"; stroke: "#C9CEDA"; stroke-width: 2; stroke-dash: 4; border-radius: 16; font-size: 22; bold: true; font-color: "#2A2F3C"}}
}

title: |md
  # clipper — who runs it, and how improvements travel
  one copy of the rules · owner pushes · everyone else sends pull requests · every change is tested
| {near: top-center}

people: PEOPLE & AGENTS {
  class: stage
  direction: right
  owner: "owner\n(macOS)" {class: person}
  friend: "collaborator\n(Windows)" {class: person}
  hermes: "Hermes\nclipper profile\nNYO glm-5.3-flash" {class: agent}
  opencode: "OpenCode\nNYO glm-5.3-flash" {class: agent}
  owner -> hermes: asks
  friend -> opencode: asks
}

repo: THE REPOSITORY (one copy) {
  class: stage
  direction: right
  agents: "AGENTS.md\nrules for every agent\n+ git workflow" {class: rule}
  skill: ".agents/skills/clipping\nhow to run + editorial brief" {class: rule}
  pipe: "pipeline/\nclips · reedit · score · trends" {class: repo}
  docs: "README · docs/\nCHANGELOG · architecture" {class: rule}
}

github: GITHUB (private) {
  class: stage
  direction: right
  main: "main\n(protected)" {class: repo; shape: cylinder}
  branch: "improve/… branch\n+ pull request\nwhat · why · how tested" {class: repo}
  ci: "checks\nWindows + Linux\ninstall + test run" {class: check}
  branch -> ci
  ci -> main: "green ✓ → merge"
  ci -> branch: "red ✗ → fix" {style: {stroke: "#C0392B"; stroke-dash: 3}}
}

people -> repo: "both agents read the same rules\nand run the same pipeline"
people.hermes -> github.main: "owner: commit + push\n(automatic)"
people.opencode -> github.branch: "tested, general improvement:\nopens a PR by itself"
github.main -> repo: "git pull\n(everyone)" {style.stroke-dash: 3}
