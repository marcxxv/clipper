# Portrait overview. Regenerate with: bash docs/architecture/render.sh
vars: {d2-config: {layout-engine: elk; theme-id: 0; pad: 32}}
direction: down
style: {fill: "#FAFBFD"; font-color: "#182B42"}
classes: {
  step: {width: 590; style: {fill: "#FFFFFF"; stroke: "#CBD5E1"; stroke-width: 1; border-radius: 12; bold: false; font-size: 18}}
  group: {style: {fill: "#F1F5F9"; stroke: "#CBD5E1"; stroke-width: 1; border-radius: 16; font-size: 20; bold: true}}
  lane: {width: 270; height: 100; style: {fill: "#EFF5FC"; stroke: "#A9BFD9"; stroke-width: 1; border-radius: 12; bold: false; font-size: 17}}
}
title: |md
  # CLIPPER / WORKING TOGETHER
  One repository. Shared rules. Tested improvements.
| {near: top-center}
people: "01  /  PEOPLE & AGENTS" {
  class: group
  grid-columns: 2
  grid-gap: 20
  owner: "OWNER · macOS\nHermes / clipper profile\nNYO glm-5.3-flash" {class: lane}
  friend: "COLLABORATOR · Windows\nOpenCode\nNYO glm-5.3-flash" {class: lane}
}
repo: "02  /  ONE SHARED REPOSITORY\nAGENTS.md · workflow and permissions\n.agents/skills/clipping/ · run guide and editorial brief\npipeline/ · implementation and docs/ · documentation" {class: step}
share: "03  /  SHARE A TESTED CHANGE" {
  class: group
  grid-columns: 2
  grid-gap: 20
  direct: "OWNER\nCommit + push to main\nOwner bypass is allowed" {class: lane}
  pr: "COLLABORATOR\nimprove/… branch → pull request\nDescribe what, why and tests" {class: lane}
}
checks: "04  /  GITHUB CHECKS\nWindows + Linux · install and offline pipeline run\nD2 sources must match the committed diagrams\nFix failures; merge collaborator PRs when green" {class: step}
main: "05  /  MAIN → EVERYONE\nOwner updates and approved improvements\ngit pull brings the shared changes to each computer" {
  class: step
  style: {fill: "#EAF5EF"; stroke: "#93B7A3"}
}
people -> repo -> share -> checks -> main
notes: |md
  **Every push and pull request runs checks.**

  Owner pushes reach main before CI completes.

  **Stays local** · keys, videos, clips and personal settings
| {near: bottom-center}
