# Portrait overview. Regenerate with: bash docs/architecture/render.sh
vars: {d2-config: {layout-engine: elk; theme-id: 0; pad: 32}}
direction: down
style: {fill: "#FAFBFD"; font-color: "#182B42"}
classes: {
  step: {width: 590; style: {fill: "#FFFFFF"; stroke: "#CBD5E1"; stroke-width: 1; border-radius: 12; bold: false; font-size: 18}}
  local: {style: {fill: "#EFF5FC"; stroke: "#A9BFD9"; stroke-width: 1; border-radius: 12; bold: false; font-size: 16}}
  ai: {style: {fill: "#FFF5E6"; stroke: "#D2AB68"; stroke-width: 1; border-radius: 12; bold: false; font-size: 16}}
  group: {style: {fill: "#F1F5F9"; stroke: "#CBD5E1"; stroke-width: 1; border-radius: 16; font-size: 20; bold: true}}
}
title: |md
  # CLIPPER
  From source video to vertical shorts.
| {near: top-center}

source: "01  /  SOURCE\nYouTube link or a local video\nyt-dlp downloads up to 1080p" {class: step}
listen: "02  /  TRANSCRIBE\nLocal speech recognition → word timings → voice alignment\nfaster-whisper · cached for the next run" {class: step}
route: "03  /  CHOOSE A MODE\nMeasure speech density and camera cuts\nAuto-detect, or override with --mode" {class: step}
select: "04  /  FIND THE STORY" {
  class: group
  grid-columns: 3
  grid-gap: 16
  talk: "CLIPS · AI\nTalks & podcasts\nStrong standalone moments\nSentence + overlap checks" {class: ai; width: 210; height: 116}
  visual: "VISUAL · LOCAL\nGameplay, sports & music\nLoudness peaks\n+ bursts of camera cuts" {class: local; width: 210; height: 116}
  story: "REEDIT · AI\nTrailers & promos\nReorder source lines\nHook → build → payoff" {class: ai; width: 210; height: 116}
}
rank: "05  /  RANK · CLIPS & VISUAL ONLY\nVoice + picture + AI review of 3 phone-view frames\nCategory weights → strongest first; re-edits skip ranking" {class: step}
make: "06  /  FRAME & FINISH\nPer-shot face crop, two-person split or padded wide shot\nKaraoke captions · −14 LUFS · verify picture + sound\nRe-edits also use cross-fades" {class: step}
result: "07  /  REVIEW YOUR OUTPUT\n1080 × 1920 video + title & hashtags + report\nClips: numbered best first + review.png\nRe-edits: A / B / C shorts + compare.mp4" {
  class: step
  style: {fill: "#EAF5EF"; stroke: "#93B7A3"}
}
source -> listen -> route -> select
select -> rank
rank -> make
make -> result

notes: |md
  **Shared inputs** · SKILL.md editorial brief

  Optional trend briefs · personal campaign settings

  **Color key** · blue: local selection · amber: AI · green: output

  Transcription and rendering run locally.

  Visual mode: --no-ai also skips paid scoring.
| {near: bottom-center}
